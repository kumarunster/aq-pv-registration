    "/api/v1/providers/{provider_id}/drafts": {
      "post": {
        "tags": [
          "Drafts (no final submission)"
        ],
        "summary": "Create",
        "description": "Create a portal draft or explicitly local staging record. Never finalize/submit.\n\nNRM/ENM initialize empty cart products only. e-netz saves the initial site.\nMainzer remote draft creation is unavailable for the inspected Journey.\nA timeout is NOT automatically retried. Use the same key to retrieve a completed result.",
        "operationId": "create_api_v1_providers__provider_id__drafts_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "provider_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ProviderId"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
