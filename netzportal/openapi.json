{
  "openapi": "3.1.0",
  "info": {
    "title": "PV Netzanmeldung Multi-Provider API",
    "description": "Unofficial adapters for NRM, ENM, Mainzer Netze and e-netz Suedhessen. Read operations and limited draft initialization; no final submission. Lists the configured account's applications from Bestellungen / Alle. Uses server-side provider credentials; API callers authenticate with a separate bearer key.",
    "version": "0.4.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health",
        "description": "Process liveness only; does not contact NRM or verify its availability.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/installations": {
      "get": {
        "tags": [
          "Installations"
        ],
        "summary": "List Installations",
        "description": "Fetch every application in NRM's current 'Alle' response, including closed ones.\n\nEach entry is an application/order-product, not a unique physical installation.\nNo drafts or full technical system details are included in this first version.",
        "operationId": "list_installations_api_v1_installations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationList"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API bearer key"
          },
          "502": {
            "description": "NRM sign-in/session/schema error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "NRM unavailable or rate-limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "NRM request timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
