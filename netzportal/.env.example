# Server-side provider accounts. Never commit the real .env file.
NRM_USERNAME=your-nrm-username
# Single quotes preserve literal $ characters when Compose reads this file.
NRM_PASSWORD='your-nrm-password'
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
NETZPORTAL_API_KEY=replace-with-a-random-key-at-least-32-characters-long
NRM_HOST=127.0.0.1
NRM_PORT=8080
NRM_TIMEOUT_SECONDS=30

# Additional providers are optional; configure both values of each pair.
ENM_USERNAME=
ENM_PASSWORD=
MAINZER_USERNAME=
MAINZER_PASSWORD=
ENETZ_USERNAME=
ENETZ_PASSWORD=

# Persistent draft journal/local JSON staging; keep private and back up.
# PV_DATA_DIR=/path/to/private/state
