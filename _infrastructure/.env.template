# ===========================================
# Amelanq Netz-Anmeldung - Environment Template
# Kopieren nach .env und Werte setzen:
#   cp .env.template .env
# Secrets erzeugen:  openssl rand -hex 32
# ===========================================

# --- Allgemein ---
TZ=Europe/Berlin
APP_ENV=development

# Lokaler Dev-Port (nginx). In Produktion ungenutzt - dort uebernimmt der
# externe nginx-proxy die Veroeffentlichung (ports-Mapping in compose ist aus).
PUBLIC_HTTP_PORT=8092

# Basis-URL (Dev)
PUBLIC_BASE_URL=http://localhost:8092

# --- MongoDB ---
MONGO_DATABASE=netzanmeldung
MONGO_USER=naadmin
MONGO_PASSWORD=CHANGE_ME

# --- Kratos Postgres ---
KRATOS_DB_USER=kratos
KRATOS_DB_PASSWORD=CHANGE_ME
KRATOS_DB_NAME=kratos

# --- Kratos Secrets (je 32 Zeichen hex) ---
# Wichtig: EXAKT 32 Zeichen, sonst startet Kratos nicht.
KRATOS_COOKIE_SECRET=CHANGE_ME
KRATOS_CIPHER_SECRET=CHANGE_ME
KRATOS_LOG_LEVEL=info

# --- Oathkeeper ---
OATHKEEPER_LOG_LEVEL=info

# ===========================================
# Fachliche Parameter
# Noch leer - folgen mit dem Datenmodell (Roadmap Schritt 1).
# ===========================================
